{
  "name": "word-researcher-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build --config taskpane/vite.config.ts",
    "check": "npm run typecheck",
    "hashes": "node scripts/run_locked_python.mjs scripts/compute_phase1_hashes.py",
    "lint": "eslint taskpane/src taskpane/tests --max-warnings=0",
    "pyright": "pyright --project pyrightconfig.json",
    "typecheck": "tsc --noEmit -p taskpane/tsconfig.json",
    "generate": "node scripts/run_locked_python.mjs scripts/generate_contracts.py",
    "generate:check": "npm run verify:generated",
    "test": "vitest run --config taskpane/vitest.config.ts",
    "test:https-bind": "node scripts/run_locked_python.mjs scripts/run_https_loopback_probe.py",
    "test:production-origin": "node scripts/run_locked_python.mjs scripts/run_installed_production_origin_test.py",
    "test:protocol": "node scripts/run_locked_python.mjs scripts/run_generated_client_protocol_roundtrip.py",
    "ci:pins": "node scripts/run_locked_python.mjs scripts/check_ci_action_pins.py",
    "verify:architecture": "node scripts/run_locked_python.mjs scripts/verify_architecture.py",
    "verify:generated": "node scripts/run_locked_python.mjs scripts/check_generated.py",
    "verify:security": "node scripts/run_locked_python.mjs scripts/verify_security_surface.py",
    "validate:manifest": "office-addin-manifest validate manifest/word-researcher.xml"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/office-js": "1.0.604",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "jsdom": "29.0.1",
    "office-addin-manifest": "2.1.6",
    "pyright": "1.1.411",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
